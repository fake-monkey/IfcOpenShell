@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(WASM_BUILD OFF)
set(USE_MMAP OFF)
if(WASM_BUILD)
    set(BOOST_COMPONENTS)
else()
    # @todo review this, shouldn't this be all possible header-only now?
    # ... or rewritten using C++17 features?
    set(BOOST_COMPONENTS system program_options regex thread date_time)
endif()

if(USE_MMAP)
    if(MSVC)
        # filesystem is necessary for the utf-16 wpath
        set(BOOST_COMPONENTS ${BOOST_COMPONENTS} iostreams filesystem)
    else()
        set(BOOST_COMPONENTS ${BOOST_COMPONENTS} iostreams)
    endif()
endif()
unset(WASM_BUILD)
unset(USE_MMAP)

# 查找依赖
set(Boost_USE_STATIC_LIBS OFF)
find_dependency(Eigen3 CONFIG REQUIRED)
find_dependency(Boost CONFIG REQUIRED COMPONENTS ${BOOST_COMPONENTS})
find_dependency(OpenCASCADE CONFIG REQUIRED)

# 引入Targets
include("${CMAKE_CURRENT_LIST_DIR}/IfcOpenShellTargets.cmake")
unset(BOOST_COMPONENTS)
